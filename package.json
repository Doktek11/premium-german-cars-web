{
  "name": "premium-german-cars",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "postbuild": "react-snap",
    "preview": "vite preview --host",
    "build:check": "npm run build && node ./scripts/check-bundle.mjs",
    "perf:baseline": "MAX_INITIAL_JS_KB=280 npm run build:check",
    "perf:target": "MAX_INITIAL_JS_KB=240 npm run build:check",
    "perf:strict": "BUNDLE_CHECK_STRICT=1 MAX_INITIAL_JS_KB=220 npm run build:check",
    "release:check": "npm run perf:strict"
  },
  "dependencies": {
    "@vercel/analytics": "^1.6.1",
    "lucide-react": "^0.344.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^2.0.5",
    "react-router-dom": "^6.22.3"
  },
  "devDependencies": {
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "postcss": "^8.4.35",
    "react-snap": "^1.23.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.2.2",
    "vite": "^5.4.0"
  },
  "reactSnap": {
    "source": "dist",
    "routes": [
      "/",
      "/calculadora-impuesto-matriculacion"
    ],
    "include": [
      "/",
      "/calculadora-impuesto-matriculacion"
    ],
    "inlineCss": false,
    "crawl": false,
    "skipThirdPartyRequests": true,
    "puppeteerArgs": [
      "--no-sandbox",
      "--disable-setuid-sandbox"
    ]
  }
}
